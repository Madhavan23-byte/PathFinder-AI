# ============================================================
# PathFinder — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.env
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.virtualenv/
pip-wheel-metadata/

# --- Node / Frontend ---
node_modules/
dist/
.cache/
.parcel-cache/
*.local

# --- Environment Variables (NEVER commit real secrets) ---
.env
.env.local
.env.development
.env.staging
.env.production

# Keep example files (no real secrets)
!.env.example
!backend/.env.example

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# --- Vercel ---
.vercel/
